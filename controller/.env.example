# Copy this file to .env and replace every placeholder before starting the controller.
# Encode PEM line breaks in APP_PRIVATE_KEY as literal backslash-n sequences (\n).
APP_ID=replace-with-github-app-id
APP_PRIVATE_KEY=replace-with-one-line-pem-private-key
APP_CLIENT_ID=replace-with-github-oauth-client-id
APP_CLIENT_SECRET=replace-with-github-oauth-client-secret
WEBHOOK_SECRET=replace-with-github-app-webhook-secret
PUBLIC_URL=https://controller.example.com
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Percent-encode the DATABASE_URL password (including literal % as %25 and @ as %40).
DATABASE_URL=postgres://robin:replace-with-postgres-password@db:5432/robin
# Keep this Compose password raw, not URL-encoded; quote it as needed for Compose .env syntax
# (single-quoted values preserve literal $ characters). It must match DATABASE_URL's decoded password.
POSTGRES_PASSWORD=replace-with-postgres-password

# Optional settings
# PORT=3000
# PGSSL=false
# TRUST_PROXY_CIDRS=192.0.2.10/32
# ROBIN_WORKFLOW_TEMPLATE=/app/templates/robin.yml
